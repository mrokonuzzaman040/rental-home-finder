# Copy to .env and adjust. Never commit .env.

DJANGO_DEBUG=True
DEBUG=True
SECRET_KEY=change-me-use-get_random_secret_key-in-production

# Comma-separated hosts (required when DEBUG=False)
ALLOWED_HOSTS=127.0.0.1,localhost

# HTTPS origins for CSRF when using TLS (comma-separated full origins)
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database file name (SQLite)
DB_NAME=db.sqlite3

# AI
GEMINI_API_KEY=

# Optional: change admin URL path (must end with /)
# ADMIN_URL_PATH=admin/

# Set True when behind nginx/Cloudflare so SECURE_* and request.is_secure() work
# BEHIND_TLS_PROXY=False

# Production TLS (typically True when DEBUG=False behind HTTPS)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
